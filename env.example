# ============================================================================
#  MLBB Market Bot sozlamalari
#  Ishga tushirishdan oldin bu faylni `.env` nomi bilan nusxalang:
#      cp env.example .env
#
#  MUHIM: bu fayldagi deyarli BARCHA qiymatlar (narx chegaralari, vaqtlar,
#  kanal, garant akkaunti, AI kaliti, anti-flood va hokazo) bot ichidagi
#  «⚙️ Sozlamalar» panelidan ham o'zgartiriladi va bazada saqlanadi. Shu
#  sababli loyihani sotib olgan kishi `.env` fayliga umuman tegmasa ham
#  bo'ladi — bot ichidan boshqarish yetarli.
# ============================================================================

# --- Asosiy ------------------------------------------------------------------
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithRealOne

# Asosiy administratorning Telegram ID si (@userinfobot orqali aniqlanadi)
ADMIN_ID=123456789

# E'lonlar joylanadigan va majburiy a'zolik tekshiriladigan kanal
# Masalan: @mlbb_savdo  yoki  -1001234567890
DEFAULT_CHANNEL_ID=@mlbb_savdo

# Garant xizmati akkaunti (foydalanuvchi nomi, @ belgisisiz)
GARANT_USERNAME=my_garant

# Ixtiyoriy: ma'lumotlar bazasi fayli yo'li
DB_PATH=market_database.sqlite3

# Ixtiyoriy: share (ulashish) havolalaridagi bot username'i zaxirasi.
# Bo'sh qoldirilsa bot ishga tushganda `bot.get_me()` orqali avtomatik
# aniqlanadi — qo'lda kiritish shart emas.
# BOT_USERNAME=my_mlbb_bot

# ============================================================================
#  KUNLIK HISOBOT (23:59 da adminlarga yuboriladi)
# ============================================================================
# Hisobot qaysi vaqtda yuborilishi (mahalliy vaqt, O'zbekiston = UTC+5)
TZ_OFFSET_HOURS=5
DIGEST_HOUR=23
DIGEST_MINUTE=59

# ============================================================================
#  E'LON AMAL MUDDATI, OBUNA, KUNNING TANLOVI VA ZAXIRA NUSXA
# ============================================================================
# E'lon necha kun amal qiladi. Muddat tugagach e'lon arxivlanadi, egasi
# «🔄 Yangilash» tugmasi orqali uni yana shu muddatga uzaytira oladi.
LISTING_TTL_DAYS=14

# O'xshash e'lonlar qidiruvida narx farqi (±ulush). 0.3 = ±30%
SIMILAR_PRICE_TOLERANCE=0.3

# Har bir taklif qilingan do'st uchun beriladigan bepul VIP e'lonlar soni
REFERRAL_REWARD_VIP=1

# Kanalga har kuni «🌟 Kunning tanlovi» e'lonini joylash (mahalliy vaqt)
FEATURED_ENABLED=true
FEATURED_HOUR=12
FEATURED_MINUTE=0

# Har kuni bazaning zaxira nusxasini olish (mahalliy vaqt) va saqlanadigan
# nusxalar soni. Nusxalarni admin panel orqali qo'lda ham yuklab olish mumkin.
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_HOUR=3
BACKUP_KEEP=7

# ============================================================================
#  AI MODERATSIYA (ixtiyoriy)
#  Barcha qiymatlarni bot ichidan ham kiritish mumkin:
#      ⚙️ Sozlamalar → 🤖 AI moderatsiya
#  Kalit uchun tavsiya etilgan xizmat: OpenRouter (https://openrouter.ai).
#  OpenAI-mos har qanday provayder ishlaydi (OpenAI, Groq, DeepInfra, ...).
# ============================================================================

# AI moderatsiyani yoqish. Kalit kiritilmaguncha avtomatik tekshiruv ishlamaydi.
AI_ENABLED=false

# API kaliti (masalan sk-or-v1-...). Bot ichida kiritilsa shu yerda saqlash
# shart emas va kiritilgan xabar chatdan o'chiriladi.
AI_API_KEY=

# OpenAI-mos API manzili (oxirida / YO'Q)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model nomi
AI_MODEL=openai/gpt-4o-mini

# AI javobi ishonch darajasi shu foizdan yuqori bo'lsa e'lonni avtomatik
# TASDIQLASH (admin baribir xabardor qilinadi)
AI_AUTO_APPROVE=false

# AI firibgarlik/spam deb topsa e'lonni avtomatik RAD ETISH
AI_REJECT_SCAMS=true

# Avtomatik qaror uchun minimal ishonch darajasi (0-100)
AI_MIN_CONFIDENCE=70

# AI so'roviga ajratilgan vaqt (sekund)
AI_TIMEOUT_SECONDS=20

# AI uchun qo'shimcha qoidalar (bo'sh bo'lsa faqat standart qoidalar qo'llanadi)
AI_EXTRA_RULES=

# ============================================================================
#  ANTI-FLOOD (spamga qarshi himoya) — YUMSHATILGAN REJIM
#  Sukut qiymatlar oddiy foydalanuvchiga umuman sezilmaydi: cheklov faqat
#  botni Telegram tomonidan bloklanishdan (HTTP 429) himoya qilish uchun.
# ============================================================================

# Umumiy yoqish/o'chirish
FLOOD_PROTECTION=true

# Kuzatuv oynasi (sekund) va shu oynada ruxsat etilgan hodisalar soni.
# 12 / 5s ≈ sekundiga 2.4 so'rov — bu Telegram chegarasidan ancha past,
# oddiy foydalanuvchi esa hech qachon bunga yetmaydi.
FLOOD_WINDOW_SECONDS=5
FLOOD_MAX_EVENTS=12

# Ogohlantirishlar orasidagi minimal vaqt (sekund)
FLOOD_NOTICE_COOLDOWN=4

# Nechta buzilishdan keyin mute qo'llaniladi (5 marta) va mute davomiyligi
FLOOD_VIOLATION_LIMIT=5
FLOOD_MUTE_SECONDS=30

# Foydalanuvchi shu vaqt tinch tursa, buzilish hisobi nolga tushadi (sekund)
FLOOD_MUTE_RESET_SECONDS=120

# Ogohlantirish xabari necha sekunddan keyin o'chiriladi
FLOOD_WARNING_TTL=6

# Foydalanuvchining xabarlarini o'chirish (yumshoq rejimda O'CHIRILGAN)
FLOOD_DELETE_MESSAGES=false

# "Jimgina rejim": false qilsangiz ogohlantirish ham, mute xabari ham
# yuborilmaydi — takroriy so'rovlar shunchaki o'tkazib yuboriladi.
FLOOD_NOTIFY=true

# Administratorni cheklovdan ozod qilish
FLOOD_BYPASS_ADMIN=true

# ============================================================================
#  O'Z-O'ZINI O'CHIRUVCHI XABARLAR (self-destruct) + /clean
# ============================================================================
# Umumiy yoqish/o'chirish
SELF_DESTRUCT_ENABLED=true

# Botning shaxsiy chatdagi xabarlari necha sekunddan keyin o'chiriladi.
# 0 = avtomatik o'chirish o'chirilgan (qo'lda /clean ishlayveradi).
SELF_DESTRUCT_DEFAULT_TTL=300

# `temporary()` bilan yuborilgan qisqa bildirishnomalar uchun TTL (sekund)
SELF_DESTRUCT_NOTICE_TTL=12

# Foydalanuvchining o'z xabarlarini ham o'chirish (chat butunlay toza turadi)
SELF_DESTRUCT_USER_MESSAGES=false
SELF_DESTRUCT_USER_TTL=600

# /clean uchun chat bo'yicha eslab qolinadigan xabarlar soni
CLEANER_TRACK_LIMIT=40

# Bu chatlar hech qachon avtomatik tozalanmaydi
# (ADMIN_ID sukut bo'yicha qo'shiladi; kanallar/guruhlar har doim himoyalangan)
# SELF_DESTRUCT_SKIP_CHAT_IDS=123456789,-1001234567890
