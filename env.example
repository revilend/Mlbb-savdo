# ============================================================================
#  MLBB Market Bot sozlamalari
#  Ishga tushirishdan oldin bu faylni `.env` nomi bilan nusxalang:
#      cp env.example .env
# ============================================================================

# --- Asosiy ------------------------------------------------------------------
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithRealOne

# Asosiy administratorning Telegram ID si (@userinfobot orqali aniqlanadi)
ADMIN_ID=123456789

# E'lonlar joylanadigan va majburiy a'zolik tekshiriladigan kanal
# Masalan: @mlbb_savdo  yoki  -1001234567890
DEFAULT_CHANNEL_ID=@mlbb_savdo

# Garant xizmati akkaunti (foydalanuvchi nomi, @ belgisisiz)
GARANT_USERNAME=my_garant

# Ixtiyoriy: ma'lumotlar bazasi fayli yo'li
DB_PATH=market_database.sqlite3

# ============================================================================
#  ANTI-FLOOD (spamga qarshi himoya) — YUMSHATILGAN REJIM
#  Sukut qiymatlar oddiy foydalanuvchiga umuman sezilmaydi: cheklov faqat
#  botni Telegram tomonidan bloklanishdan (HTTP 429) himoya qilish uchun.
# ============================================================================

# Umumiy yoqish/o'chirish
FLOOD_PROTECTION=true

# Kuzatuv oynasi (sekund) va shu oynada ruxsat etilgan hodisalar soni.
# 12 / 5s ≈ sekundiga 2.4 so'rov — bu Telegram chegarasidan ancha past,
# oddiy foydalanuvchi esa hech qachon bunga yetmaydi.
FLOOD_WINDOW_SECONDS=5
FLOOD_MAX_EVENTS=12

# Ogohlantirishlar orasidagi minimal vaqt (sekund)
FLOOD_NOTICE_COOLDOWN=4

# Nechta buzilishdan keyin mute qo'llaniladi (5 marta) va mute davomiyligi
FLOOD_VIOLATION_LIMIT=5
FLOOD_MUTE_SECONDS=30

# Foydalanuvchi shu vaqt tinch tursa, buzilish hisobi nolga tushadi (sekund)
FLOOD_MUTE_RESET_SECONDS=120

# Ogohlantirish xabari necha sekunddan keyin o'chiriladi
FLOOD_WARNING_TTL=6

# Foydalanuvchining xabarlarini o'chirish (yumshoq rejimda O'CHIRILGAN)
FLOOD_DELETE_MESSAGES=false

# "Jimgina rejim": false qilsangiz ogohlantirish ham, mute xabari ham
# yuborilmaydi — takroriy so'rovlar shunchaki o'tkazib yuboriladi.
FLOOD_NOTIFY=true

# Administratorni cheklovdan ozod qilish
FLOOD_BYPASS_ADMIN=true

# ============================================================================
#  O'Z-O'ZINI O'CHIRUVCHI XABARLAR (self-destruct) + /clean
# ============================================================================
# Umumiy yoqish/o'chirish
SELF_DESTRUCT_ENABLED=true

# Botning shaxsiy chatdagi xabarlari necha sekunddan keyin o'chiriladi.
# 0 = avtomatik o'chirish o'chirilgan (qo'lda /clean ishlayveradi).
SELF_DESTRUCT_DEFAULT_TTL=300

# `temporary()` bilan yuborilgan qisqa bildirishnomalar uchun TTL (sekund)
SELF_DESTRUCT_NOTICE_TTL=12

# Foydalanuvchining o'z xabarlarini ham o'chirish (chat butunlay toza turadi)
SELF_DESTRUCT_USER_MESSAGES=false
SELF_DESTRUCT_USER_TTL=600

# /clean uchun chat bo'yicha eslab qolinadigan xabarlar soni
CLEANER_TRACK_LIMIT=40

# Bu chatlar hech qachon avtomatik tozalanmaydi
# (ADMIN_ID sukut bo'yicha qo'shiladi; kanallar/guruhlar har doim himoyalangan)
# SELF_DESTRUCT_SKIP_CHAT_IDS=123456789,-1001234567890
